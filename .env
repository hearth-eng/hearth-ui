PORT=8443
BASE_PATH=/gateway/v1

REDIS_HOST=localhost
REDIS_PORT=6379

HEARTH_SERVER=https://localhost:9443
STORE_PASS=secret

# mTLS configuration
# key and cert identify Node as the client.
# ca lets Node trust the Vert.x server certificate.
# rejectUnauthorized: true ensures the server cert must verify correctly.
# servername should match the SAN on the Vert.x certificate.

MTLS_SERVER_NAME=localhost
MTLS_CLIENT_STORE=store/hearth-ui.pem
MTLS_CA_STORE=store/ca_javalabs.crt

# JWT configuration
JWT_KEYSTORE=store/hearth.pkcs

OTP_EXP_MIN=5
TOKEN_TTL_MIN=600

AUTH_TOKEN_URL=/mgmt/login
SERVICE_CLIENT_ID=29b2a038-4e87-4e83-96bb-7110a27f09bf
SERVICE_CLIENT_SECRET=6cb75f652a9b52798eb6cf2201057c73

LOG_LEVEL=trace

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_PASS=empty
SMTP_USER={user}@gmail.com
SMTP_FROM={user}@gmail.com